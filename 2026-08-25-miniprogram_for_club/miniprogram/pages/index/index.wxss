.container {
  position: relative;
  min-height: 100vh;
  padding: 140rpx 20rpx 20rpx;
  box-sizing: border-box;
  background: transparent;
}

/* 全局背景图 */
.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 背景装饰斜线（在背景之上，内容之下） */
.bg-diagonal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: repeating-linear-gradient(
    45deg,
    rgba(0, 163, 255, 0.03) 0,
    rgba(0, 163, 255, 0.03) 2rpx,
    transparent 2rpx,
    transparent 20rpx
  );
  z-index: 1;
  pointer-events: none;
}

/* 返回按钮（毛玻璃胶囊） */
.back-btn {
  position: fixed;
  top: 20rpx;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border-radius: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  font-size: 26rpx;
  color: #17498C;
}

.back-icon {
  font-size: 36rpx;
  line-height: 1;
}

/* 活动卡片（毛玻璃 + 大圆角 + 阴影） */
.activity-card {
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06), inset 0 0 0 1px rgba(255,255,255,0.5);
  padding: 30rpx;
}

/* 左上角标签（切角平行四边形） */
.skew-tag {
  display: inline-block;
  background: #FF6100;
  color: #fff;
  padding: 6rpx 20rpx;
  transform: skewX(-10deg);
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 0 8rpx 0 8rpx; /* 小圆角修饰 */
}

/* 活动标题（倾斜 BA 风格） */
.activity-title {
  font-family: 'Oswald', 'PingFang SC', sans-serif;
  font-size: 40rpx;
  font-weight: bold;
  color: #1A1E24;
  margin: 20rpx 0 15rpx;
  transform: rotate(-1deg);
}

/* 活动信息 */
.activity-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: #555;
  font-size: 28rpx;
}

/* 报名数据块 */
.data-block {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 15rpx;
  padding-top: 15rpx;
  border-top: 1px solid rgba(0,0,0,0.08);
}

.data-highlight {
  color: #FF6100;
  font-weight: bold;
  font-family: 'Oswald', monospace;
  font-size: 32rpx;
}

.data-label {
  font-size: 24rpx;
  color: #999;
}

/* 加载与空状态 */
.loading-tip,
.no-more {
  position: relative;
  z-index: 1;
  text-align: center;
  color: #999;
  padding: 20rpx 0;
  font-size: 26rpx;
}

.empty {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

/* 活动封面缩略图 */
.activity-cover {
  width: 100%;
  height: 300rpx;             /* 可调整高度 */
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.cover-img {
  width: 100%;
  height: 100%;
}

/* 搜索框 */
.search-bar {
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.search-input {
  width: 100%;
  height: 70rpx;
  padding: 0 30rpx;
  border-radius: 35rpx;
  background: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  color: #333;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}