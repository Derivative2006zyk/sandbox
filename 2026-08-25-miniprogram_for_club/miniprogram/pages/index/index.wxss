.container {
  position: relative;
  min-height: 100vh;
  padding: 140rpx 20rpx 20rpx;
  box-sizing: border-box;
  background: transparent;   /* 透明以显示背景图 */
}

/* 全局背景图 */
.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 背景装饰斜线（在背景之上，但在内容之下） */
.bg-diagonal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: repeating-linear-gradient(
    45deg,
    rgba(0, 163, 255, 0.03) 0,
    rgba(0, 163, 255, 0.03) 2rpx,
    transparent 2rpx,
    transparent 20rpx
  );
  z-index: 1;
  pointer-events: none;
}

/* 返回按钮（固定定位，最高层） */
.back-btn {
  position: fixed;
  top: 20rpx;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  font-size: 26rpx;
  color: #17498C;
}

.back-icon {
  font-size: 36rpx;
  line-height: 1;
}

/* 活动卡片等内容（在背景之上） */
.activity-card {
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.activity-title {
  font-family: 'Oswald', 'PingFang SC', sans-serif;
  font-size: 40rpx;
  font-weight: bold;
  color: #1A1E24;
  margin: 20rpx 0 15rpx;
  transform: rotate(-1deg);
}

.activity-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: #666;
  font-size: 28rpx;
}

.data-block {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 15rpx;
  padding-top: 15rpx;
  border-top: 1px solid rgba(0,0,0,0.05);
}

.data-label {
  font-size: 24rpx;
  color: #999;
}

.loading-tip,
.no-more {
  position: relative;
  z-index: 1;
  text-align: center;
  color: #999;
  padding: 20rpx 0;
  font-size: 26rpx;
}

.empty {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}