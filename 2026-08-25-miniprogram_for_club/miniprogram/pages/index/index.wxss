.container {
  position: relative;
  min-height: 100vh;
  padding: 140rpx 20rpx 20rpx;
  box-sizing: border-box;
  background: transparent;
}

.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.bg-diagonal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: repeating-linear-gradient(
    45deg,
    rgba(0, 163, 255, 0.03) 0,
    rgba(0, 163, 255, 0.03) 2rpx,
    transparent 2rpx,
    transparent 20rpx
  );
  z-index: 1;
  pointer-events: none;
}

.back-btn {
  position: fixed;
  top: 20rpx;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border-radius: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  font-size: 26rpx;
  color: #17498C;
}

.back-icon {
  font-size: 36rpx;
  line-height: 1;
}

/* 选项卡 */
.home-tabs {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: center;
  gap: 30rpx;
  margin-bottom: 20rpx;
  padding: 10rpx 0;
}

.home-tab {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.6);
}

.home-tab.active {
  background: #2F8DFF;
  color: #fff;
}

/* 搜索框 */
.search-bar {
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.search-input {
  width: 100%;
  height: 70rpx;
  padding: 0 30rpx;
  border-radius: 35rpx;
  background: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  color: #333;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

/* 列表卡片 */
.list-item {
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06), inset 0 0 0 1px rgba(255,255,255,0.5);
  padding: 30rpx;
}

.list-cover {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.skew-tag {
  display: inline-block;
  background: #FF6100;
  color: #fff;
  padding: 6rpx 20rpx;
  transform: skewX(-10deg);
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 0 8rpx 0 8rpx;
  margin-bottom: 15rpx;
}

.skew-tag.news {
  background: #2F8DFF;
}

.skew-tag.announcement {
  background: #FF9F1C;
}

.item-title {
  font-family: 'Oswald', 'PingFang SC', sans-serif;
  font-size: 40rpx;
  font-weight: bold;
  color: #1A1E24;
  margin: 15rpx 0;
  transform: rotate(-1deg);
}

.item-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: #555;
  font-size: 28rpx;
}

.info-line {
  display: block;
}

.draft-flag {
  color: #ff4d4f;
  font-size: 24rpx;
  font-weight: bold;
}

.data-highlight {
  color: #FF6100;
  font-weight: bold;
  font-family: 'Oswald', monospace;
  font-size: 32rpx;
}

.loading-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx 0;
  position: relative;
  z-index: 1;
}

.loading-dots .dot {
  width: 12rpx;
  height: 12rpx;
  margin: 0 6rpx;
  border-radius: 50%;
  background-color: #999999;
  animation: dot-bounce 1.2s infinite ease-in-out;
}

.loading-dots .dot:nth-child(1) { animation-delay: -0.32s; }
.loading-dots .dot:nth-child(2) { animation-delay: -0.16s; }
.loading-dots .dot:nth-child(3) { animation-delay: 0s; }

@keyframes dot-bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.6; }
  40% { transform: scale(1); opacity: 1; }
}

.no-more {
  position: relative;
  z-index: 1;
  text-align: center;
  color: #999;
  padding: 20rpx 0;
  font-size: 26rpx;
}

.empty {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}