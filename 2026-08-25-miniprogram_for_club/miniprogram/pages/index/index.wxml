<view class="container">
  <!-- 全局背景图 -->
  <image class="page-bg" src="{{bgUrl}}" mode="aspectFill"></image>

  <!-- 背景装饰斜线 -->
  <view class="bg-diagonal"></view>

  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="goBackToMenu">
    <text class="back-icon">‹</text>
    <text class="back-text">返回</text>
  </view>

  <!-- 三选项卡 -->
  <view class="home-tabs">
    <view class="home-tab {{currentHomeTab === 'news' ? 'active' : ''}}" data-tab="news" bindtap="switchHomeTab">新闻</view>
    <view class="home-tab {{currentHomeTab === 'announcement' ? 'active' : ''}}" data-tab="announcement" bindtap="switchHomeTab">公告</view>
    <view class="home-tab {{currentHomeTab === 'activity' ? 'active' : ''}}" data-tab="activity" bindtap="switchHomeTab">活动</view>
  </view>

  <!-- 活动搜索框（仅活动选项卡显示） -->
  <view class="search-bar" wx:if="{{currentHomeTab === 'activity'}}">
    <input 
      class="search-input" 
      placeholder="搜索活动标题或地点" 
      value="{{keyword}}" 
      bindinput="onSearchInput"
      confirm-type="search"
    />
  </view>

  <!-- 列表区域 -->
  <block wx:if="{{displayList.length > 0}}">
    <view 
      class="list-item glass-card" 
      wx:for="{{displayList}}" 
      wx:key="_id"
      bindtap="onItemTap"
      data-id="{{item._id}}"
      data-type="{{item.type}}">
      
      <!-- 缩略图（如有） -->
      <view class="list-cover" wx:if="{{item.coverThumb}}">
        <image class="cover-img" src="{{item.coverThumb}}" mode="aspectFill" lazy-load></image>
      </view>

      <!-- 标签 -->
      <view class="skew-tag {{item.tagClass}}">{{item.tagText}}</view>

      <!-- 标题 -->
      <view class="item-title">{{item.title}}</view>

      <!-- 信息区：活动 vs 新闻/公告 -->
      <view wx:if="{{item.type === 'activity'}}" class="item-info">
        <text class="info-line">时间：{{item.time}}</text>
        <text class="info-line">地点：{{item.location}}</text>
        <text class="info-line">报名：<text class="data-highlight">{{item.participantCount}}</text></text>
      </view>
      <view wx:else class="item-info">
        <text class="info-line">日期：{{item.date}}</text>
      </view>

      <!-- 已结束活动灰色毛玻璃遮罩 -->
      <view class="ended-mask" wx:if="{{item.isEnded}}">
        <text class="ended-text">已结束</text>
      </view>
    </view>

    <!-- 加载动画 -->
    <view class="loading-dots" wx:if="{{listLoading}}">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && displayList.length > 0}}">没有更多了</view>
  </block>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{displayList.length === 0 && !listLoading}}">
    <text>{{keyword ? '没有找到匹配的活动' : '暂无内容'}}</text>
  </view>
</view>