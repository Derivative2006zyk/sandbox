<view class="container">
  <!-- 全局背景图 -->
  <image class="page-bg" src="{{bgUrl}}" mode="aspectFill"></image>

  <!-- 用户信息卡片 -->
  <view class="user-card glass-card" wx:if="{{userInfo}}">
    <view class="user-avatar">
      <text class="avatar-text">{{userInfo.nickname ? userInfo.nickname[0] : '?'}}</text>
    </view>
    <view class="user-info">
      <text class="name">{{userInfo.nickname || '未设置昵称'}}</text>
      <text class="bio">{{userInfo.bio || '这个人很懒，还没写简介'}}</text>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-item glass-card" bindtap="goMySignups">
    <text class="menu-text">我的报名</text>
    <text class="menu-arrow">›</text>
  </view>
  <view class="menu-item glass-card" bindtap="goFund">
    <text class="menu-text">社费公示</text>
    <text class="menu-arrow">›</text>
  </view>
  <view wx:if="{{userInfo.role === 1}}" class="menu-item glass-card" bindtap="goAdmin">
    <text class="menu-text">管理后台</text>
    <text class="menu-arrow">›</text>
  </view>
  <view class="menu-item glass-card" bindtap="goFeedback">
    <text class="menu-text">意见反馈</text>
    <text class="menu-arrow">›</text>
  </view>

  <button class="edit-btn angle-btn" bindtap="goEditProfile">编辑资料</button>
</view>