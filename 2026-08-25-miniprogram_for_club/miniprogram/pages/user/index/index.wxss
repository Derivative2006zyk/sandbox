.container {
  position: relative;
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  background: transparent;   /* 透明显示背景图 */
}

/* 全局背景图 */
.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 内容元素在背景之上 */
.user-card,
.menu-item,
.edit-btn {
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
}

.user-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
  color: #17498C;
}

.student-id {
  font-size: 28rpx;
  color: #666;
}

.menu-item {
  font-size: 30rpx;
  color: #333;
  padding: 25rpx 30rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.edit-btn {
  width: 100%;
  padding: 25rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  font-size: 30rpx;
  color: #17498C;
}