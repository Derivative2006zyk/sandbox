.container {
  position: relative;
  min-height: 100vh;
  padding: 80rpx 32rpx 40rpx;
  box-sizing: border-box;
  background: transparent;
}

.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.glass-card {
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 25rpx 30rpx;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #2F8DFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
  color: #17498C;
}

.student-id {
  font-size: 26rpx;
  color: #666;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.menu-text {
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #999;
}

.edit-btn {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  width: 100%;
  background: #1A1E24;
  color: #ffffff;
  border: none;
  border-radius: 0;
  clip-path: polygon(15rpx 0, 100% 0, 100% calc(100% - 15rpx), calc(100% - 15rpx) 100%, 0 100%, 0 15rpx);
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}