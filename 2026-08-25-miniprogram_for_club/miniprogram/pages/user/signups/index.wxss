.container {
  padding: 20rpx;
}

.loading, .empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.signup-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.activity-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
  color: #333;
}

.signup-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: #666;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.cancel-btn {
  width: 100%;
  background: #ff4d4f;
  color: #fff;
  border-radius: 8rpx;
}