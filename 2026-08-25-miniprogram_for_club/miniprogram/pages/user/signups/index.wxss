.container {
  position: relative;
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  background: transparent;
}

/* 全局背景图 */
.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.loading,
.empty {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.signup-card {
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 25rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.activity-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
  color: #17498C;
}

.signup-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: #666;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.cancel-btn {
  width: 100%;
  background: #ff4d4f;
  color: #fff;
  border-radius: 8rpx;
}