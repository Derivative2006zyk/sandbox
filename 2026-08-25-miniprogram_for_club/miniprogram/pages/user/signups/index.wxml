<view class="container">
  <!-- 全局背景图 -->
  <image class="page-bg" src="{{bgUrl}}" mode="aspectFill"></image>

  <!-- 自定义返回按钮 -->
  <view class="custom-back" bindtap="goBack">
    <text class="back-icon">‹</text>
    <text class="back-text">返回</text>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="g-loading">
    <view class="g-loading-card">
      <image class="g-loading-img" src="/images/hello.jpg" mode="aspectFit"></image>
      <text class="g-loading-title">请稍等</text>
      <text class="g-loading-emoji">(＾▽＾)</text>
      <text class="g-loading-note">页面加载中，请稍候...</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && list.length === 0}}" class="empty">
    <text>暂无报名记录</text>
  </view>

  <!-- 报名列表 -->
  <view wx:if="{{!loading && list.length > 0}}">
    <view class="signup-card glass-card" wx:for="{{list}}" wx:key="signupId">
      <view class="activity-title" wx:if="{{item.activity}}">{{item.activity.title}}</view>
      <view class="activity-title" wx:else>活动已删除</view>
      <view class="signup-info">
        <text>报名时间：{{item.createTime}}</text>
        <text>昵称：{{item.formData.nickname || item.formData.name || '微信用户'}}</text>
      </view>
      <button class="cancel-btn" size="mini" bindtap="cancelSignup" data-id="{{item.activityId}}">取消报名</button>
    </view>
  </view>
</view>