.container {
  position: relative;
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  background: transparent;
}

/* 全局背景图 */
.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.form-card {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  color: #333;
  font-size: 28rpx;
}

.label .req {
  color: #FF4D4F;
  margin-left: 4rpx;
}

.label .opt {
  color: #999;
  font-size: 24rpx;
  margin-left: 4rpx;
}

.input {
  border-bottom: 1rpx solid #ddd;
  padding: 15rpx 0;
  font-size: 30rpx;
  line-height: 1.5;
  background: transparent;
}

.submit-btn {
  margin-top: 60rpx;
  width: 100%;
  background: #2F8DFF;
  color: #fff;
  border-radius: 8rpx;
}