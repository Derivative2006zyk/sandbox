<view class="container">
  <image class="page-bg" src="{{bgUrl}}" mode="aspectFill"></image>

  <view class="form-card glass-card">
    <view class="form-item">
      <text class="label">昵称<text class="req">*</text></text>
      <input class="input" value="{{nickname}}" data-field="nickname" bindinput="onInput" placeholder="请输入昵称（活动报名标识，可随意填写）" />
    </view>
    <view class="form-item">
      <text class="label">个人简介<text class="opt">（选填）</text></text>
      <textarea class="input" value="{{bio}}" data-field="bio" bindinput="onInput" placeholder="介绍一下自己吧（选填）" maxlength="100" />
    </view>
    <button class="submit-btn" bindtap="submit" disabled="{{submitting}}">{{submitting ? '保存中...' : '保存'}}</button>
  </view>
</view>