/* 页面整体 */
.menu-page {
  position: relative;
  min-height: 120vh;
  background: transparent;
  overflow-x: hidden;
  font-family: 'HarmonyOS Sans', 'PingFang SC', sans-serif;
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* 全局背景图 */
.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 背景装饰斜线 */
.bg-diagonal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: repeating-linear-gradient(
    45deg,
    rgba(0, 0, 0, 0.02) 0,
    rgba(0, 0, 0, 0.02) 2rpx,
    transparent 2rpx,
    transparent 20rpx
  );
  z-index: 1;
  pointer-events: none;
}

/* 空心标题 NEWS */
.news-outline {
  position: relative;
  z-index: 1;
  font-size: 120rpx;
  font-weight: 900;
  color: transparent;
  -webkit-text-stroke: 2rpx #D1E9F9;
  letter-spacing: 8rpx;
  margin-top: 40rpx;
  margin-bottom: -90rpx;
  text-align: left;
}

/* ========== 轮播图区域（平行四边形样式，对角圆角白色边框，填满无白边） ========== */
.banner-area {
  position: relative;
  z-index: 1;
  width: 630rpx;
  margin: 20rpx auto 0;
}

/* 外层倾斜容器 */
.banner-outer {
  position: relative;
  transform: skewX(-5deg);
  filter: drop-shadow(10rpx 12rpx 16rpx rgba(0, 0, 0, 0.6));
}

/* 切角与描边容器 */
.banner-clip {
  border-radius: 16rpx 0 16rpx 0;
  border: 3rpx solid #ffffff;
  background: #ffffff;
  overflow: hidden;
  box-shadow: 0 0 0 2rpx rgba(255,255,255,0.5);
}

/* swiper 覆盖容器，直接填满，不放大不偏移 */
.banner-swiper {
  width: 100%;
  height: 380rpx;
}

.banner-item {
  width: 100%;
  height: 100%;
  position: relative;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-no-img {
  width: 100%;
  height: 100%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
}

.banner-info {
  position: absolute;
  left: 32rpx;
  bottom: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  z-index: 2;
}

.banner-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF9F1C;
  text-shadow: 0 0 10rpx rgba(0,0,0,0.7);
}

.banner-subtitle {
  font-size: 24rpx;
  color: #FFFFFF;
}

/* 左右箭头（反向倾斜，保持直立） */
.arrow {
  position: absolute;
  top: 45%;
  transform: translateY(-50%) skewX(5deg);
  font-size: 200rpx;            /* 加大箭头尺寸 */
  color: #ffffff7a;
  z-index: 10;
  line-height: 1;
}

.arrow.left { left: -10rpx; }
.arrow.right { right: -10rpx; }

/* 自定义指示器圆点 */
.custom-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 30rpx;
  gap: 12rpx;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #CCCCCC;
  transition: all 0.3s;
}

.dot.active {
  width: 12rpx;
  height: 12rpx;
  background: #17498C;
}

/* 轮播图占位（无数据） */
.banner-placeholder {
  width: 630rpx;
  height: 380rpx;
  margin: 20rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.5);
  border-radius: 12rpx;
  color: #999;
  font-size: 28rpx;
}

/* ========== 分类标签导航（居中） ========== */
.tabs {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-top: 64rpx;
}

.tab {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  opacity: 0.8;
}

.tab.active {
  color: #17498C;
  opacity: 1;
}

.dot-sep {
  color: #CCCCCC;
  font-size: 28rpx;
}

/* 斑马纹分割线 */
.tabs-divider {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 2rpx;
  margin-top: 16rpx;
  background-image: repeating-linear-gradient(
    135deg,
    #DDDDDD 0,
    #DDDDDD 4rpx,
    transparent 4rpx,
    transparent 12rpx
  );
}

/* ========== 新闻列表 ========== */
.news-list {
  position: relative;
  z-index: 1;
  margin-top: 40rpx;
}

.news-item {
  display: flex;
  align-items: center;
  height: 120rpx;
  border-bottom: 1rpx solid #EEEEEE;
  padding: 0 32rpx;
}

.news-cover {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 16rpx;
}

.news-cover-img {
  width: 100%;
  height: 100%;
}

.news-tag {
  flex-shrink: 0;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #FFFFFF;
  margin-right: 16rpx;
}

.news-tag.news { background: #2F8DFF; }
.news-tag.activity { background: #FF9F1C; }

.news-title {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.news-date {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #8899AA;
  margin-left: 16rpx;
}

/* 空状态、加载状态 */
.empty-tip,
.loading-tip,
.no-more {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
  font-size: 28rpx;
}

/* ========== 底部区域 ========== */
.footer-area {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 48rpx;
  padding-bottom: 40rpx;
}

/* SCROLL 提示 */
.scroll-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.scroll-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #17498C;
}

.arrow-down {
  width: 16rpx;
  height: 16rpx;
  border-right: 2rpx solid #17498C;
  border-bottom: 2rpx solid #17498C;
  transform: rotate(45deg);
  margin-top: 8rpx;
  animation: float 1.5s infinite;
}

@keyframes float {
  0%, 100% { transform: rotate(45deg) translateY(0); }
  50% { transform: rotate(45deg) translateY(8rpx); }
}

/* 更多按钮 */
.more-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 32rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  border: 1rpx solid #2F8DFF;
  color: #2F8DFF;
  font-size: 26rpx;
}

.more-btn .dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #2F8DFF;
}

/* 草案公告红点 */
.draft-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff0000;
  margin-left: 8rpx;
  flex-shrink: 0;
}