.container {
  position: relative;
  min-height: 100vh;
  padding: 120rpx 20rpx 20rpx;
  background: transparent;
  box-sizing: border-box;
}

.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.custom-back {
  position: fixed;
  top: 20rpx;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border-radius: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  font-size: 26rpx;
  color: #17498C;
}

.back-icon {
  font-size: 36rpx;
  line-height: 1;
}

.loading {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.news-detail {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 30rpx;
}

.header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.tag {
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #fff;
}
.tag.news { background: #2F8DFF; }
.tag.activity { background: #FF9F1C; }

.date {
  font-size: 24rpx;
  color: #8899AA;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #17498C;
  margin-bottom: 30rpx;
}

.news-image {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
}

.news-image-img {
  width: 100%;
  height: 100%;
}

.content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 草案公告提示 */
.draft-notice {
  background: #fffbe6;
  color: #d4380d;
  font-size: 32rpx;
  font-weight: bold;
  padding: 20rpx;
  border-radius: 12rpx;
  border-left: 8rpx solid #ff4d4f;
  margin-bottom: 20rpx;
}

/* 表决区域 */
.vote-section {
  margin-top: 40rpx;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 16rpx;
  border: 1rpx solid #e0e0e0;
}

.vote-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.vote-stats {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #555;
  margin-bottom: 20rpx;
}

.vote-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.vote-btn {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 35rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
  background: #e0e0e0;
  color: #333;
}

.vote-btn.agree.active {
  background: #52c41a;
  color: #fff;
}

.vote-btn.disagree.active {
  background: #ff4d4f;
  color: #fff;
}

.vote-btn.abstain.active {
  background: #bfbfbf;
  color: #fff;
}

.vote-tip {
  font-size: 24rpx;
  color: #888;
  display: block;
  text-align: center;
}