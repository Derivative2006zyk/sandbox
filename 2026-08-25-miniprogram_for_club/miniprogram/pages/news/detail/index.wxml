<view class="container">
  <image class="page-bg" src="{{bgUrl}}" mode="aspectFill"></image>

  <view class="custom-back" bindtap="goBack">
    <text class="back-icon">‹</text>
    <text class="back-text">返回</text>
  </view>

  <view wx:if="{{loading}}" class="g-loading">
    <view class="g-loading-card">
      <image class="g-loading-img" src="/images/hello.jpg" mode="aspectFit"></image>
      <text class="g-loading-title">请稍等</text>
      <text class="g-loading-emoji">(＾▽＾)</text>
      <text class="g-loading-note">页面加载中，请稍候...</text>
    </view>
  </view>

  <view wx:if="{{news}}" class="news-detail glass-card">
    <view class="header">
      <view class="tag {{news.category === 'activity' ? 'activity' : 'news'}}">{{news.tag}}</view>
      <text class="date">{{news.date}}</text>
    </view>
    <view class="title">{{news.title}}</view>

    <view class="news-image" wx:if="{{news.imageThumb || news.image}}">
      <image class="news-image-img" src="{{news.imageThumb || news.image}}" mode="aspectFill"></image>
    </view>

    <view class="content">{{news.content}}</view>
  </view>
</view>
