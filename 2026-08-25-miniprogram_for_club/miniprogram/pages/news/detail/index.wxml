<view class="container">
  <!-- 全局背景图 -->
  <image class="page-bg" src="/images/background.jpg" mode="aspectFill"></image>

  <!-- 自定义返回按钮 -->
  <view class="custom-back" bindtap="goBack">
    <text class="back-icon">‹</text>
    <text class="back-text">返回</text>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:if="{{news}}" class="news-detail">
    <!-- 标题卡片 -->
    <view class="glass-card title-card">
      <view class="title">{{news.title}}</view>
    </view>

    <!-- 宣传图片（若有） -->
    <view class="news-image" wx:if="{{news.imageThumb || news.image}}">
      <image class="news-image-img" src="{{news.imageThumb || news.image}}" mode="aspectFill"></image>
    </view>

    <!-- 信息卡片（标签、日期） -->
    <view class="glass-card info-card">
      <view class="header">
        <view class="tag {{news.category === 'activity' ? 'activity' : 'news'}}">{{news.tag}}</view>
        <text class="date">{{news.date}}</text>
      </view>
    </view>

    <!-- 内容卡片 -->
    <view class="glass-card content-card">
      <view class="content">{{news.content}}</view>
    </view>
  </view>
</view>