.container {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: transparent;
}

/* 背景装饰层 */
.bg-decor {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.triangle {
  position: absolute;
  width: 0;
  height: 0;
  border-style: solid;
  opacity: 0.1;
}
.triangle-1 { top: 10%; left: 5%; border-width: 0 30rpx 50rpx 30rpx; border-color: transparent transparent #F2E7D5 transparent; transform: rotate(15deg); }
.triangle-2 { top: 20%; right: 10%; border-width: 0 40rpx 70rpx 40rpx; border-color: transparent transparent #F2E7D5 transparent; transform: rotate(-20deg); }
.triangle-3 { bottom: 20%; left: 15%; border-width: 0 20rpx 35rpx 20rpx; border-color: transparent transparent #F2E7D5 transparent; transform: rotate(30deg); }

.line {
  position: absolute;
  background-color: #D0D0D0;
  opacity: 0.05;
}
.line-1 { top: 30%; left: 0; width: 100%; height: 1rpx; transform: rotate(-3deg); }
.line-2 { bottom: 40%; left: 0; width: 100%; height: 1rpx; transform: rotate(2deg); }

/* 全局背景图 */
.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 返回按钮 */
.back-btn {
  position: fixed;
  top: 20rpx;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border-radius: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  font-size: 26rpx;
  color: #17498C;
}

.back-icon {
  font-size: 36rpx;
  line-height: 1;
}

/* 左上信息区 */
.top-info {
  position: absolute;
  left: 40rpx;
  top: 80rpx;
  z-index: 10;
  pointer-events: none;
}
.en-title {
  font-size: 80rpx;
  font-weight: 700;
  color: #4E9DE6;
  letter-spacing: 4rpx;
  margin-bottom: 10rpx;
}
.cn-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}
.subtitle {
  font-size: 28rpx;
  color: #999;
}

/* 左侧垂直菜单 */
.side-menu {
  position: fixed;
  left: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 48rpx;
  z-index: 10;
}

.menu-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  background-color: #F0F0F0;
  border: 1rpx solid #D0D0D0;
  transition: all 0.3s;
}

.menu-circle:active {
  transform: scale(0.95);
}

.menu-circle.active {
  background-color: #E8F4FD;
  border: 2rpx solid #4E9DE6;
  color: #1A73E8;
}

.menu-circle.guga {
  background-color: #FAF0F0;
}

/* 中央主视觉占位 */
.main-visual {
  position: absolute;
  left: 20%;
  right: 20%;
  top: 20%;
  bottom: 25%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.visual-placeholder {
  width: 100%;
  height: 100%;
  background-color: #F5F5F5;
  border: 2rpx dashed #CCCCCC;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.placeholder-text {
  font-size: 40rpx;
  color: #999999;
  opacity: 0.5;
  margin-bottom: 10rpx;
}
.placeholder-sub {
  font-size: 28rpx;
  color: #CCCCCC;
}

/* ========== 底部导航区（下移一个菜单圆圈直径） ========== */
.bottom-nav {
  position: fixed;
  bottom: calc(20% - 96rpx);   /* 原 20%，下移 96rpx */
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
}

.fade-in {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 角色列表容器 */
.role-list {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 角色头像行 */
.role-items {
  display: flex;
  gap: 20rpx;
}

/* 单个角色项 */
.role-item {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #f0f0f0 0%, #e0e0e0 100%);
  border: 1rpx solid #DDDDDD;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  overflow: hidden;
  position: relative;
}

/* 选中状态 */
.role-item.selected {
  border: 2rpx solid #FF9CCE;
  transform: scale(1.1);
  box-shadow: 0 0 12rpx rgba(255, 156, 206, 0.5);
}

/* 角色内部占位头像 */
.role-avatar {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(0,0,0,0.1);
}

/* 滚动提示 */
.scroll-indicator {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 16rpx;
  color: #4E9DE6;
  font-size: 20rpx;
  font-weight: bold;
}

.arrow-down {
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid #4E9DE6;
  border-bottom: 2rpx solid #4E9DE6;
  transform: rotate(45deg);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 60rpx;
  height: 60rpx;
  background: #F0F0F0;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #999999;
}

/* ========== 可拓展版权区域 ========== */
.expandable {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  overflow: hidden;
  transition: height 0.3s ease;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(10px);
  border-radius: 24rpx 24rpx 0 0;
  z-index: 20;
}

.expandable::before {
  content: '';
  display: block;
  height: 4rpx;
  background: #2F8DFF;
  width: 100%;
}

.info-section {
  padding: 30rpx;
  text-align: center;
}

.info-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-top: 15rpx;
  margin-bottom: 5rpx;
}

.info-text {
  font-size: 26rpx;
  color: #555;
  display: block;
  line-height: 1.6;
}

/* 操作提示 */
.hint {
  position: absolute;
  bottom: 120rpx;
  left: 0;
  width: 100%;
  text-align: center;
  color: #999;
  font-size: 24rpx;
  z-index: 1;
  white-space: pre-line;
}