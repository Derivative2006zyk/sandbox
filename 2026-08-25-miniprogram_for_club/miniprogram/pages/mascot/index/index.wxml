<view class="container" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <!-- 背景装饰层 -->
  <view class="bg-decor">
    <view class="triangle triangle-1"></view>
    <view class="triangle triangle-2"></view>
    <view class="triangle triangle-3"></view>
    <view class="line line-1"></view>
    <view class="line line-2"></view>
  </view>

  <!-- 全局背景图 -->
  <image class="page-bg" src="{{bgUrl}}" mode="aspectFill"></image>

  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="goBack">
    <text class="back-icon">‹</text>
    <text class="back-text">返回</text>
  </view>

  <!-- 左上信息区 -->
  <view class="top-info">
    <view class="en-title">MASCOT</view>
    <view class="cn-title">{{currentMascotName}}</view>
  </view>

  <!-- 左侧垂直菜单 -->
  <view class="side-menu">
    <view 
      class="menu-circle {{currentMenu === 'shenren' ? 'active' : ''}}" 
      bindtap="handleMenuClick" 
      data-menu="shenren"
    >神人</view>
    <view 
      class="menu-circle {{currentMenu === 'guga' ? 'active' : ''}} guga" 
      bindtap="handleMenuClick" 
      data-menu="guga"
    >咕嘎</view>
  </view>

  <!-- 中央主视觉占位 -->
  <view class="main-visual">
    <view class="visual-placeholder" wx:if="{{!selectedMascot}}">
      <text class="placeholder-text">暂无吉祥物</text>
    </view>
    <image wx:else class="main-mascot-img" src="{{selectedMascot.imageUrl}}" mode="aspectFit"></image>
  </view>

  <!-- 底部导航区 -->
  <view class="bottom-nav {{navFade ? 'fade-in' : ''}}">
    <view wx:if="{{roleList.length > 0}}" class="role-list">
      <view class="role-items">
        <view 
          wx:for="{{roleList}}" 
          wx:key="_id" 
          class="role-item {{selectedRoleIndex === index ? 'selected' : ''}}"
          bindtap="selectRole"
          data-index="{{index}}"
        >
          <image class="role-image" src="{{item.imageUrl}}" mode="aspectFill" lazy-load></image>
        </view>
      </view>
      <view class="scroll-indicator">
        <text class="scroll-text">SCROLL</text>
        <view class="arrow-down"></view>
      </view>
    </view>
    <view wx:else class="empty-state">
      <view class="empty-icon"></view>
      <text class="empty-text">暂无角色</text>
    </view>
  </view>

  <!-- 可拓展版权信息区域 -->
  <view class="expandable" style="height: {{expanded ? '50vh' : '0'}}">
    <view class="info-section glass-card">
      <view class="info-title">版权信息</view>
      <text class="info-text">© 2026 樱花日语社</text>
      <view class="info-title">社团成员信息</view>
      <text class="info-text">社长：杨梓豪（2026）魏叶坤宇（2025）</text>
      <text class="info-text">副社长：张跃锟（2026），邵成齐（2025）</text>
      <text class="info-text">学习部长：万筱萌</text>
      <text class="info-text">动漫部长：张宇晗</text>
      <text class="info-text">宣传部长：张旭晟</text>
      <text class="info-text">文艺部长：梅逸翔</text>
      <text class="info-text">其他社员：2025级及2026级所有社员</text>
      <text class="info-text">\n\n</text>
      <text class="info-text">鸣谢：所有老社员</text>
    </view>
  </view>

  <!-- 操作提示 -->
  <view class="hint" wx:if="{{!expanded}}">
    <text>上滑查看版权与成员信息\n下滑返回菜单页</text>
  </view>
</view>