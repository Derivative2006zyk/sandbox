<view class="container">
  <!-- 全局背景图 -->
  <image class="page-bg" src="{{bgUrl}}" mode="aspectFill"></image>

  <!-- 自定义返回按钮 -->
  <view class="custom-back" bindtap="goBack">
    <text class="back-icon">‹</text>
    <text class="back-text">返回</text>
  </view>

  <view class="feedback-card glass-card">
    <view class="feedback-title">意见反馈</view>
    <text class="field-label">反馈内容<text class="req">*</text></text>
    <textarea
      class="feedback-input"
      placeholder="请输入您的意见或建议..."
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="500"
    ></textarea>
    <text class="privacy-tip">为保护隐私，反馈仅收集您填写的内容，不收集联系方式等身份信息。</text>
    <button class="submit-btn" bindtap="submitFeedback" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交反馈'}}
    </button>
  </view>
</view>