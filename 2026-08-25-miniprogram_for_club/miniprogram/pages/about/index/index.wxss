page {
  background-color: #F7FBFF;
  font-family: 'HarmonyOS Sans', 'PingFang SC', sans-serif;
}

.container {
  position: relative;
  min-height: 100vh;
  padding: 120rpx 40rpx 40rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.bg-decor {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.line {
  position: absolute;
  width: 100%;
  height: 1rpx;
  background: #D0D0D0;
  opacity: 0.1;
}
.line-1 { top: 30%; transform: rotate(-3deg); }
.line-2 { bottom: 40%; transform: rotate(2deg); }

.back-btn {
  position: fixed;
  top: 20rpx;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border-radius: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  font-size: 26rpx;
  color: #17498C;
}

.back-icon {
  font-size: 36rpx;
  line-height: 1;
}

.content {
  position: relative;
  z-index: 1;
  max-width: 600rpx;
  margin: 0 auto;
  text-align: center;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #17498C;
  margin-bottom: 20rpx;
}

.divider {
  width: 80rpx;
  height: 2rpx;
  background: #2F8DFF;
  margin: 0 auto 40rpx;
}

.intro-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
  display: block;
  text-align: left;
}