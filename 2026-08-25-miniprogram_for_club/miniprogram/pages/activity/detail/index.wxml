<view class="container" wx:if="{{activity}}">
  <!-- 全局背景图 -->
  <image class="page-bg" src="{{bgUrl}}" mode="aspectFill"></image>

  <!-- 自定义返回按钮 -->
  <view class="custom-back" bindtap="goBack">
    <text class="back-icon">‹</text>
    <text class="back-text">返回</text>
  </view>

  <!-- 标题卡片 -->
  <view class="glass-card title-card">
    <view class="skew-tag">{{activity.type || '活动'}}</view>
    <view class="title title-skew">{{activity.title}}</view>
  </view>

  <!-- 宣传图片 -->
  <view class="detail-cover" wx:if="{{activity.coverThumb || activity.cover}}">
    <image class="detail-cover-img" src="{{activity.coverThumb || activity.cover}}" mode="aspectFill"></image>
  </view>

  <!-- 活动信息卡片 -->
  <view class="glass-card info-card">
    <view class="info-list">
      <text class="info-item">时间：{{activity.startTime}}</text>
      <text class="info-item">地点：{{activity.location}}</text>
      <text class="info-item">报名截止：{{activity.signupDeadline}}</text>
      <text class="info-item">人数：<text class="data-highlight">{{activity.currentParticipants}}/{{activity.maxParticipants}}</text></text>
    </view>
  </view>

  <!-- 活动介绍 -->
  <view class="glass-card content-card">
    <text class="desc-title">活动介绍</text>
    <text class="desc-content">{{activity.description}}</text>
  </view>

  <!-- 活动照片（按分组展示） -->
  <view class="glass-card content-card" wx:if="{{sections.length > 0}}">
    <text class="desc-title">活动照片</text>
    <view class="photo-section" wx:for="{{sections}}" wx:key="section" wx:for-item="group">
      <text class="photo-section-title">{{group.section}}</text>
      <view class="photo-wall">
        <view class="photo-wall-item" wx:for="{{group.photos}}" wx:key="_id" wx:for-item="photo">
          <image class="photo-wall-img" src="{{photo.url}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{photo.url}}"></image>
          <text class="photo-caption" wx:if="{{photo.caption}}">{{photo.caption}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 管理员：管理活动图片入口（添加 + 修改） -->
  <button wx:if="{{isAdmin}}" class="manage-photo-btn" bindtap="goManagePhotos">管理活动图片</button>

  <!-- 报名/取消按钮 -->
  <view class="action-area">
    <button wx:if="{{!isSignedUp}}" class="angle-btn" bindtap="goSignup">立即报名</button>
    <button wx:else class="angle-btn" bindtap="cancelSignup" disabled="{{submitting}}">取消报名</button>
  </view>
</view>

<!-- 加载中 -->
<view wx:if="{{loading}}" class="g-loading">
  <view class="g-loading-card">
    <image class="g-loading-img" src="/images/hello.jpg" mode="aspectFit"></image>
    <text class="g-loading-title">请稍等</text>
    <text class="g-loading-emoji">(＾▽＾)</text>
    <text class="g-loading-note">页面加载中，请稍候...</text>
  </view>
</view>
