.container {
  padding: 20rpx;
  background: #f6f6f6;
  min-height: 100vh;
}

.activity-header {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.info-item {
  font-size: 28rpx;
  color: #666;
}

.activity-description {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.desc-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.desc-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
}

.action-area {
  padding: 20rpx 0;
}

.primary-btn {
  background: #4A90E2;
  color: #fff;
  border-radius: 8rpx;
}

.cancel-btn {
  background: #ff4d4f;
  color: #fff;
  border-radius: 8rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}