.container {
  position: relative;
  min-height: 100vh;
  padding: 120rpx 20rpx 20rpx;
  background: transparent;
  box-sizing: border-box;
}

/* 全局背景图 */
.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 自定义返回按钮 */
.custom-back {
  position: fixed;
  top: 20rpx;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border-radius: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  font-size: 26rpx;
  color: #17498C;
}

.back-icon {
  font-size: 36rpx;
  line-height: 1;
}

/* 毛玻璃卡片 */
.glass-card {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.title-card {
  padding-top: 20rpx;
}

.skew-tag {
  display: inline-block;
  background: #FF6100;
  color: #fff;
  padding: 6rpx 20rpx;
  transform: skewX(-10deg);
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 0 8rpx 0 8rpx;
  margin-bottom: 15rpx;
}

.title {
  font-family: 'Oswald', 'PingFang SC', sans-serif;
  font-size: 44rpx;
  font-weight: bold;
  color: #1A1E24;
  transform: rotate(-1deg);
}

.detail-cover {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 360rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.detail-cover-img {
  width: 100%;
  height: 100%;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  color: #555;
  font-size: 28rpx;
}

.data-highlight {
  color: #FF6100;
  font-weight: bold;
  font-family: 'Oswald', monospace;
}

.desc-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.desc-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

.action-area {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  margin-bottom: 40rpx;
}

.loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 100;
  color: #999;
}