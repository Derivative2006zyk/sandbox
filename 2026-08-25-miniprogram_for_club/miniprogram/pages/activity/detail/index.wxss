.container {
  position: relative;
  min-height: 100vh;
  padding: 20rpx;
  background: transparent;
}

/* 全局背景图 */
.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 内容卡片在背景之上 */
.glass-card,
.activity-description {
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
}

.title-skew {
  font-family: 'Oswald', 'PingFang SC', sans-serif;
  font-size: 48rpx;
  font-weight: bold;
  transform: rotate(-2deg);
  color: #00A3FF;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  color: #666;
  font-size: 28rpx;
}

.desc-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
  color: #333;
}

.desc-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

.action-area {
  position: relative;
  z-index: 1;
  margin-top: 40rpx;
}

.loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 100;
  color: #999;
}