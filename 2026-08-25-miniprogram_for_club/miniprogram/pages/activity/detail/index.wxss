.container {
  position: relative;
  min-height: 100vh;
  padding: 220rpx 20rpx 20rpx;
  background: transparent;
  box-sizing: border-box;
}

.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.custom-back {
  position: fixed;
  top: 140rpx;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border-radius: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  font-size: 26rpx;
  color: #17498C;
}

.back-icon {
  font-size: 36rpx;
  line-height: 1;
}

.glass-card {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.title-card {
  padding-top: 20rpx;
}

.skew-tag {
  display: inline-block;
  background: #FF6100;
  color: #fff;
  padding: 6rpx 20rpx;
  transform: skewX(-10deg);
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 0 8rpx 0 8rpx;
  margin-bottom: 15rpx;
}

.title {
  font-family: 'Oswald', 'PingFang SC', sans-serif;
  font-size: 44rpx;
  font-weight: bold;
  color: #1A1E24;
  transform: rotate(-1deg);
}

.detail-cover {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 360rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.detail-cover-img {
  width: 100%;
  height: 100%;
}

.info-card {
  padding: 25rpx 30rpx;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  color: #555;
  font-size: 28rpx;
}

.data-highlight {
  color: #FF6100;
  font-weight: bold;
  font-family: 'Oswald', monospace;
}

.content-card {
  padding: 30rpx;
}

.desc-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.desc-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

.photo-section {
  margin-bottom: 24rpx;
}

.photo-section:last-child {
  margin-bottom: 0;
}

.photo-section-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #17498C;
  margin-bottom: 14rpx;
}

.photo-wall {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-wall-item {
  width: calc((100% - 32rpx) / 3);
}

.photo-wall-img {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.5);
}

.photo-caption {
  display: block;
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
  margin-top: 8rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.manage-photo-btn {
  position: relative;
  z-index: 1;
  margin: 10rpx 0 40rpx;
  background: #2F8DFF;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.action-area {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  margin-bottom: 40rpx;
}

.loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 100;
  color: #999;
}