<view class="container">
  <image class="page-bg" src="{{bgUrl}}" mode="aspectFill"></image>

  <view class="signup-card glass-card">
    <view class="signup-title">活动报名</view>
    <view class="signup-desc">点击下方按钮即可完成报名，将使用您的昵称作为报名标识。</view>
    <button class="submit-btn" bindtap="submit" disabled="{{submitting}}">{{submitting ? '报名中...' : '确认报名'}}</button>
  </view>
</view>