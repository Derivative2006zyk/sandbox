.container {
  position: relative;
  min-height: 100vh;
  padding: 220rpx 20rpx 20rpx;
  background: transparent;
  box-sizing: border-box;
}

.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.custom-back {
  position: fixed;
  top: 140rpx;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border-radius: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  font-size: 26rpx;
  color: #17498C;
}

.back-icon {
  font-size: 36rpx;
  line-height: 1;
}

.balance-card {
  position: relative;
  z-index: 1;
  background: rgba(23, 73, 140, 0.9);
  border-radius: 16rpx;
  padding: 40rpx;
  color: #fff;
  text-align: center;
  margin-bottom: 20rpx;
}

.balance-label {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 10rpx;
}

.balance-value {
  font-size: 60rpx;
  font-weight: bold;
}

.toggle-btn {
  position: relative;
  z-index: 1;
  width: 100%;
  margin-bottom: 20rpx;
  background: #fff;
  color: #17498C;
  border: 1rpx solid #17498C;
  border-radius: 8rpx;
}

.update-form {
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.field-label .req {
  color: #FF4D4F;
  margin-left: 4rpx;
}

.input {
  border-bottom: 1rpx solid #ddd;
  padding: 15rpx 0;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.submit-btn {
  width: 100%;
  background: #17498C;
  color: #fff;
  border-radius: 8rpx;
}

.section-title {
  position: relative;
  z-index: 1;
  font-size: 32rpx;
  font-weight: bold;
  margin: 20rpx 0 15rpx;
  color: #333;
}

.empty {
  position: relative;
  z-index: 1;
  text-align: center;
  color: #999;
  padding: 30rpx 0;
}

.record-item {
  position: relative;
  z-index: 1;
  margin-bottom: 15rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 12rpx;
  padding: 20rpx;
}

.record-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.record-note {
  font-size: 30rpx;
  color: #333;
}

.record-amount {
  font-size: 32rpx;
  font-weight: bold;
}

.positive { color: #52c41a; }
.negative { color: #ff4d4f; }

.record-sub {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  color: #999;
  font-size: 24rpx;
}