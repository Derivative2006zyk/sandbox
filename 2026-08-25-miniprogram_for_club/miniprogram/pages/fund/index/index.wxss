.container {
  position: relative;
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  background: transparent;
}

/* 全局背景图 */
.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 余额卡片 */
.balance-card {
  position: relative;
  z-index: 1;
  background: rgba(23, 73, 140, 0.9);
  border-radius: 16rpx;
  padding: 40rpx;
  color: #fff;
  text-align: center;
  margin-bottom: 20rpx;
}

.balance-label {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 10rpx;
}

.balance-value {
  font-size: 60rpx;
  font-weight: bold;
}

/* 管理员按钮 */
.toggle-btn {
  position: relative;
  z-index: 1;
  width: 100%;
  margin-bottom: 20rpx;
  background: #fff;
  color: #17498C;
  border: 1rpx solid #17498C;
  border-radius: 8rpx;
}

/* 修改表单 */
.update-form {
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
}

.input {
  border-bottom: 1rpx solid #ddd;
  padding: 15rpx 0;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.submit-btn {
  width: 100%;
  background: #17498C;
  color: #fff;
  border-radius: 8rpx;
}

/* 变更记录标题 */
.section-title {
  position: relative;
  z-index: 1;
  font-size: 32rpx;
  font-weight: bold;
  margin: 20rpx 0 15rpx;
  color: #333;
}

.empty {
  position: relative;
  z-index: 1;
  text-align: center;
  color: #999;
  padding: 30rpx 0;
}

/* 记录项 */
.record-item {
  position: relative;
  z-index: 1;
  margin-bottom: 15rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 12rpx;
  padding: 20rpx;
}

.record-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.record-note {
  font-size: 30rpx;
  color: #333;
}

.record-amount {
  font-size: 32rpx;
  font-weight: bold;
}

.positive { color: #52c41a; }
.negative { color: #ff4d4f; }

.record-sub {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  color: #999;
  font-size: 24rpx;
}