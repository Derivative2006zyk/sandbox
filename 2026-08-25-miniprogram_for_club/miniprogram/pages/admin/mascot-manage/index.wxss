.container {
  position: relative;
  min-height: 100vh;
  background: #F7FBFF;  /* 纯色背景兜底 */
  box-sizing: border-box;
}

.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;           /* 背景图层 */
}

.content {
  position: relative;
  z-index: 1;           /* 内容层，确保在背景图之上 */
  padding: 120rpx 20rpx 20rpx;
}

.custom-back {
  position: fixed;
  top: 20rpx;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border-radius: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  font-size: 26rpx;
  color: #17498C;
}

.back-icon {
  font-size: 36rpx;
  line-height: 1;
}

.admin-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #17498C;
  margin-bottom: 30rpx;
  text-align: center;
}

.add-btn {
  width: 100%;
  margin-bottom: 20rpx;
  background: #2F8DFF;
  color: #fff;
  border-radius: 8rpx;
}

.mascot-list {
  margin-top: 20rpx;
}

.mascot-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #ffffff;       /* 纯白不透明背景 */
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid #eee;
}

.mascot-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.mascot-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #17498C;            /* 深蓝色 */
}

.mascot-category {
  font-size: 24rpx;
  color: #555;               /* 深灰色 */
}

.mascot-actions {
  display: flex;
  gap: 12rpx;
}

.empty {
  text-align: center;
  color: #999;
  padding: 40rpx;
  font-size: 28rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 80%;
  max-height: 80vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
  color: #17498C;
}

.modal-input {
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 15rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.modal-radio {
  display: flex;
  gap: 30rpx;
  margin-bottom: 20rpx;
}

.upload-area {
  width: 200rpx;
  height: 200rpx;
  border: 1rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.5);
}

.preview-img {
  width: 100%;
  height: 100%;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}