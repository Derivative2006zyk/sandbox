<view class="container">
  <!-- 全局背景图 -->
  <image class="page-bg" src="/images/background.jpg" mode="aspectFill"></image>

  <view wx:if="{{list.length === 0 && !loading}}" class="empty">暂无报名</view>

  <view class="signup-item glass-card" wx:for="{{list}}" wx:key="_id">
    <text class="signup-name">{{item.formData.name}}（{{item.formData.studentId}}）</text>
    <text class="signup-phone">{{item.formData.phone}}</text>
  </view>
</view>