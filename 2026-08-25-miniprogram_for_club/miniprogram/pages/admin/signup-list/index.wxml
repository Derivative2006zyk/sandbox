<view class="container">
  <!-- 全局背景图 -->
  <image class="page-bg" src="{{bgUrl}}" mode="aspectFill"></image>

  <!-- 自定义返回按钮 -->
  <view class="custom-back" bindtap="goBack">
    <text class="back-icon">‹</text>
    <text class="back-text">返回</text>
  </view>

  <button class="export-btn" bindtap="exportCSV">导出名单</button>

  <view wx:if="{{list.length === 0 && !loading}}" class="empty">暂无报名</view>

  <view class="signup-item glass-card" wx:for="{{list}}" wx:key="_id">
    <text class="signup-name">{{item.formData.name}}（{{item.formData.studentId}}）</text>
    <text class="signup-phone">{{item.formData.phone}}</text>
  </view>
</view>