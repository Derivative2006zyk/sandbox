.container {
  position: relative;
  min-height: 100vh;
  padding: 220rpx 32rpx 40rpx;
  box-sizing: border-box;
  background: transparent;
}

/* 全局背景图 */
.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.custom-back {
  position: fixed;
  top: 140rpx;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border-radius: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  font-size: 26rpx;
  color: #17498C;
}

.back-icon {
  font-size: 36rpx;
  line-height: 1;
}

.page-title {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  font-weight: bold;
  color: #17498C;
  text-align: center;
  margin-bottom: 30rpx;
}

.empty {
  position: relative;
  z-index: 1;
  text-align: center;
  color: #999;
  padding: 60rpx 0;
}

.signup-item {
  position: relative;
  z-index: 1;
  margin-bottom: 15rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.signup-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #17498C;
}

.signup-time {
  font-size: 26rpx;
  color: #666;
}

.export-btn {
  width: 100%;
  margin-bottom: 20rpx;
  background: #2F8DFF;
  color: #fff;
  border-radius: 8rpx;
}