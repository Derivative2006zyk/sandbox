.container {
  position: relative;
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  background: transparent;
}

/* 全局背景图 */
.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.empty {
  position: relative;
  z-index: 1;
  text-align: center;
  color: #999;
  padding: 60rpx 0;
}

.signup-item {
  position: relative;
  z-index: 1;
  margin-bottom: 15rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.signup-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #17498C;
}

.signup-phone {
  font-size: 26rpx;
  color: #666;
}