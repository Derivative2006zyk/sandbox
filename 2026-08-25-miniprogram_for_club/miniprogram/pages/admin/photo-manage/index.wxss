.container {
  position: relative;
  min-height: 100vh;
  padding: 220rpx 20rpx 20rpx;
  box-sizing: border-box;
  background: transparent;
}

.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.custom-back {
  position: fixed;
  top: 140rpx;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border-radius: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  font-size: 26rpx;
  color: #17498C;
}

.back-icon {
  font-size: 36rpx;
  line-height: 1;
}

.page-title {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  font-weight: bold;
  color: #17498C;
  text-align: center;
  margin-bottom: 30rpx;
}

.activity-list {
  position: relative;
  z-index: 1;
  margin-bottom: 30rpx;
}

.activity-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 30rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
}

.activity-item.active {
  border-color: #2F8DFF;
  background: rgba(255, 255, 255, 0.9);
}

.activity-title {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-arrow {
  font-size: 30rpx;
  color: #2F8DFF;
  margin-left: 16rpx;
}

.list-tip {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 20rpx 0;
}

.load-more {
  color: #2F8DFF;
}

.photo-section {
  position: relative;
  z-index: 1;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #17498C;
  margin-bottom: 20rpx;
}

.hint {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 60rpx 0;
}

/* 新增分组 */
.add-section {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.section-input {
  flex: 1;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 15rpx;
  font-size: 28rpx;
  line-height: 1.5;
  background: rgba(255, 255, 255, 0.7);
  box-sizing: border-box;
}

.add-section-btn {
  flex-shrink: 0;
  background: #2F8DFF;
  color: #fff;
  font-size: 26rpx;
  border-radius: 8rpx;
}

.loading,
.empty {
  position: relative;
  z-index: 1;
  text-align: center;
  color: #999;
  padding: 60rpx 0;
  font-size: 28rpx;
}

/* 分组卡片 */
.section-group {
  margin-bottom: 30rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.group-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #17498C;
}

.group-actions {
  display: flex;
  gap: 12rpx;
}

.group-upload {
  background: #2F8DFF;
  color: #fff;
}

.group-delete {
  background: #FF4D4F;
  color: #fff;
}

.group-empty {
  text-align: center;
  color: #ccc;
  font-size: 26rpx;
  padding: 30rpx 0;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  height: 210rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.5);
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
  z-index: 3;
}

.photo-caption-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 6rpx 10rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 20rpx;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  z-index: 2;
}

/* 编辑说明弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 80%;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
  color: #17498C;
}

.caption-textarea {
  width: 100%;
  min-height: 160rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 15rpx;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.modal-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 8rpx;
}

.modal-btn.primary {
  background: #2F8DFF;
  color: #fff;
}
