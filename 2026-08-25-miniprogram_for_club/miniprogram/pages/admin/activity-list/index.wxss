.container {
  position: relative;
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  background: transparent;
}

/* 全局背景图 */
.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.create-btn {
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
  background: #2F8DFF;
  color: #fff;
  border-radius: 8rpx;
}

.empty {
  position: relative;
  z-index: 1;
  text-align: center;
  color: #999;
  padding: 60rpx 0;
}

.activity-item {
  position: relative;
  z-index: 1;
  margin-bottom: 15rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 25rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #17498C;
}

.status {
  color: #666;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}

.actions {
  display: flex;
  gap: 10rpx;
}