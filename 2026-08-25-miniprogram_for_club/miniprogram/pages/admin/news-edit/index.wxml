<view class="container">
  <!-- 全局背景图 -->
  <image class="page-bg" src="{{bgUrl}}" mode="aspectFill"></image>

  <!-- 自定义返回按钮 -->
  <view class="custom-back" bindtap="goBack">
    <text class="back-icon">‹</text>
    <text class="back-text">返回</text>
  </view>

  <view class="form-card glass-card">
    <view class="form-item">
      <text>标题</text>
      <input value="{{title}}" data-field="title" bindinput="onInput" placeholder="请输入新闻标题" />
    </view>

    <view class="form-item">
      <text>分类</text>
      <radio-group bindchange="onCategoryChange">
        <label><radio value="news" checked="{{category === 'news'}}" />新闻</label>
        <label><radio value="announcement" checked="{{category === 'announcement'}}" />公告</label>
      </radio-group>
    </view>

    <view class="form-item">
      <text>日期（可选）</text>
      <input value="{{date}}" data-field="date" bindinput="onInput" placeholder="格式：2026-08-26" />
    </view>

    <view class="form-item">
      <text>内容</text>
      <textarea value="{{content}}" data-field="content" bindinput="onInput" placeholder="请输入新闻正文" auto-height />
    </view>

    <!-- 新闻配图上传 -->
    <view class="form-item">
      <text>新闻配图</text>
      <view class="upload-area" bindtap="uploadImage">
        <image wx:if="{{imageThumb || image}}" class="cover-preview" src="{{imageThumb || image}}" mode="aspectFill"></image>
        <view wx:else class="upload-placeholder">
          <text class="upload-icon">＋</text>
          <text class="upload-text">点击上传图片</text>
        </view>
      </view>
    </view>

    <button class="submit-btn" bindtap="submit" disabled="{{submitting}}">{{submitting ? '保存中...' : '保存'}}</button>
  </view>

  <!-- 隐藏的压缩画布 -->
  <canvas canvas-id="compressCanvasNews" style="width: 300px; height: 300px; position: fixed; left: 9999px; top: 9999px;"></canvas>
</view>