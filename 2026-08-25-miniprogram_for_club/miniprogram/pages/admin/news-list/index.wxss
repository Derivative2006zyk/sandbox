.container {
  position: relative;
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  background: transparent;
}

/* 全局背景图 */
.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.create-btn {
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
  background: #2F8DFF;
  color: #fff;
  border-radius: 8rpx;
}

.empty {
  position: relative;
  z-index: 1;
  text-align: center;
  color: #999;
  padding: 60rpx 0;
}

.news-item {
  position: relative;
  z-index: 1;
  margin-bottom: 15rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info {
  flex: 1;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #17498C;
  display: block;
  margin-bottom: 5rpx;
}

.meta {
  font-size: 24rpx;
  color: #8899AA;
}

.actions {
  display: flex;
  gap: 10rpx;
}

/* 草案公告投票统计 */
.vote-stats {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.stat {
  font-size: 24rpx;
  color: #555;
  background: rgba(255, 255, 255, 0.8);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}