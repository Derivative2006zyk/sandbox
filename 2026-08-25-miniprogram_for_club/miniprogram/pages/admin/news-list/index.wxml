<view class="container">
  <!-- 全局背景图 -->
  <image class="page-bg" src="/images/background.jpg" mode="aspectFill"></image>

  <button class="create-btn" bindtap="createNews">新建新闻</button>

  <view wx:if="{{newsList.length === 0 && !loading}}" class="empty">暂无新闻</view>

  <view class="news-item glass-card" wx:for="{{newsList}}" wx:key="_id">
    <view class="info">
      <text class="title">{{item.title}}</text>
      <text class="meta">{{item.category}} | {{item.date}}</text>
    </view>
    <view class="actions">
      <button size="mini" bindtap="editNews" data-id="{{item._id}}">编辑</button>
      <button size="mini" type="warn" bindtap="deleteNews" data-id="{{item._id}}">删除</button>
    </view>
  </view>
</view>