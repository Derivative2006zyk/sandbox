<view class="container">
  <!-- 全局背景图 -->
  <image class="page-bg" src="{{bgUrl}}" mode="aspectFill"></image>

  <!-- 自定义返回按钮 -->
  <view class="custom-back" bindtap="goBack">
    <text class="back-icon">‹</text>
    <text class="back-text">返回</text>
  </view>

  <view class="page-title">{{activityId ? '编辑活动' : '新建活动'}}</view>

  <view class="form-card glass-card">
    <view class="form-item">
      <text class="label">标题<text class="req">*</text></text>
      <input value="{{title}}" data-field="title" bindinput="onInput" placeholder="请输入活动标题" />
    </view>
    <view class="form-item">
      <text class="label">地点<text class="req">*</text></text>
      <input value="{{location}}" data-field="location" bindinput="onInput" placeholder="请输入活动地点" />
    </view>
    <view class="form-item">
      <text class="label">开始时间<text class="req">*</text></text>
      <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
        <view class="picker-input">{{startDate || '选择日期'}}</view>
      </picker>
      <picker mode="time" value="{{startTimeOnly}}" bindchange="onStartTimeChange">
        <view class="picker-input">{{startTimeOnly || '选择时间'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="label">结束时间<text class="req">*</text></text>
      <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange">
        <view class="picker-input">{{endDate || '选择日期'}}</view>
      </picker>
      <picker mode="time" value="{{endTimeOnly}}" bindchange="onEndTimeChange">
        <view class="picker-input">{{endTimeOnly || '选择时间'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="label">报名截止<text class="req">*</text></text>
      <picker mode="date" value="{{deadlineDate}}" bindchange="onDeadlineDateChange">
        <view class="picker-input">{{deadlineDate || '选择日期'}}</view>
      </picker>
      <picker mode="time" value="{{deadlineTimeOnly}}" bindchange="onDeadlineTimeChange">
        <view class="picker-input">{{deadlineTimeOnly || '选择时间'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="label">人数上限<text class="req">*</text></text>
      <input type="number" value="{{maxParticipants}}" data-field="maxParticipants" bindinput="onInput" placeholder="请输入最大报名人数" />
    </view>
    <view class="form-item">
      <text class="label">类型<text class="opt">（选填）</text></text>
      <input value="{{type}}" data-field="type" bindinput="onInput" placeholder="如：讲座、聚会、比赛" />
    </view>

    <!-- 封面图片上传 -->
    <view class="form-item">
      <text class="label">活动封面<text class="opt">（选填）</text></text>
      <view class="upload-area" bindtap="uploadCover">
        <image wx:if="{{coverThumb || cover}}" class="cover-preview" src="{{coverThumb || cover}}" mode="aspectFill"></image>
        <view wx:else class="upload-placeholder">
          <text class="upload-icon">＋</text>
          <text class="upload-text">点击上传图片</text>
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="label">活动介绍<text class="opt">（选填）</text></text>
      <textarea value="{{description}}" data-field="description" bindinput="onInput" placeholder="请输入活动详细介绍" auto-height />
    </view>
    <view class="form-item">
      <text>状态</text>
      <radio-group data-field="status" bindchange="onStatusChange">
        <label><radio value="1" checked="{{status === 1}}" />发布</label>
        <label><radio value="0" checked="{{status === 0}}" />草稿</label>
      </radio-group>
    </view>
    <button class="submit-btn" bindtap="submit" disabled="{{submitting}}">{{submitting ? '保存中...' : '保存'}}</button>
  </view>

  <!-- 隐藏的压缩画布 -->
  <canvas canvas-id="compressCanvas" style="width: 300px; height: 300px; position: fixed; left: 9999px; top: 9999px;"></canvas>
</view>