.container {
  position: relative;
  min-height: 100vh;
  padding: 220rpx 32rpx 40rpx;
  box-sizing: border-box;
  background: transparent;
}

.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.custom-back {
  position: fixed;
  top: 140rpx;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border-radius: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  font-size: 26rpx;
  color: #17498C;
}

.back-icon {
  font-size: 36rpx;
  line-height: 1;
}

.page-title {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  font-weight: bold;
  color: #17498C;
  text-align: center;
  margin-bottom: 30rpx;
}

.form-card {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  margin-bottom: 20rpx;
}

.form-item text {
  display: block;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  color: #333;
}

.form-item .req {
  display: inline;
  margin: 0 0 0 4rpx;
  color: #FF4D4F;
}

.form-item .opt {
  display: inline;
  margin: 0 0 0 4rpx;
  color: #999;
  font-size: 24rpx;
}

.form-item input,
.form-item textarea {
  width: 100%;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 15rpx;
  font-size: 28rpx;
  line-height: 1.5;
  background: transparent;
  box-sizing: border-box;
}

.form-item textarea {
  min-height: 150rpx;
}

.picker-input {
  width: 100%;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 15rpx;
  font-size: 28rpx;
  line-height: 1.5;
  background: transparent;
  box-sizing: border-box;
  margin-bottom: 10rpx;
  color: #333;
}

/* 上传区域样式 */
.upload-area {
  width: 200rpx;
  height: 200rpx;
  border: 1rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: rgba(255,255,255,0.5);
}

.cover-preview {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
}

.upload-icon {
  font-size: 48rpx;
}

.upload-text {
  font-size: 24rpx;
}

.submit-btn {
  margin-top: 30rpx;
  width: 100%;
  background: #2F8DFF;
  color: #fff;
  border-radius: 8rpx;
}

radio-group label {
  margin-right: 20rpx;
}