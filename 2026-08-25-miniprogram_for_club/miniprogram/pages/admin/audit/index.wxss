.container {
  position: relative;
  min-height: 100vh;
  padding: 120rpx 20rpx 20rpx;
  background: transparent;
  box-sizing: border-box;
}

.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.custom-back {
  position: fixed;
  top: 20rpx;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border-radius: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  font-size: 26rpx;
  color: #17498C;
}

.back-icon {
  font-size: 36rpx;
  line-height: 1;
}

.review-title,
.error-tip,
.loading,
.empty,
.glass-card {
  position: relative;
  z-index: 1;
}

.review-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #17498C;
  margin-bottom: 30rpx;
  text-align: center;
}

.error-tip {
  text-align: center;
  color: #ff4d4f;
  font-size: 28rpx;
  padding: 30rpx 0;
}

.loading {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
}

.empty {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
}

.glass-card {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 25rpx;
  margin-bottom: 20rpx;
}

.draft-type {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.draft-brief {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.draft-thumb {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  margin-top: 10rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 80%;
  max-height: 80vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
  color: #17498C;
}

.modal-body {
  margin-bottom: 30rpx;
}

.detail-row {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.detail-image {
  width: 100%;
  height: auto;
  border-radius: 12rpx;
  margin-top: 10rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}