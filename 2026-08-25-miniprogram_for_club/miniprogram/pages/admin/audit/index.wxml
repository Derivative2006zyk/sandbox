<view class="container">
  <!-- 全局背景图 -->
  <image class="page-bg" src="{{bgUrl}}" mode="aspectFill"></image>

  <!-- 自定义返回按钮 -->
  <view class="custom-back" bindtap="goBack">
    <text class="back-icon">‹</text>
    <text class="back-text">返回</text>
  </view>

  <view class="review-title">待审核草案</view>

  <!-- 错误提示 -->
  <view class="error-tip" wx:if="{{errorMsg}}">{{errorMsg}}</view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <!-- 空状态（仅当非加载且无错误且列表为空时显示） -->
  <view class="empty" wx:if="{{!loading && !errorMsg && drafts.length === 0}}">暂无待审核草案</view>

  <!-- 草案列表 -->
  <view class="draft-item glass-card" wx:for="{{drafts}}" wx:key="_id" bindtap="viewDraftDetail" data-id="{{item._id}}">
    <view class="draft-type">类型：{{item.type === 'activity' ? '活动' : item.type === 'news' ? '新闻' : '表情包'}}</view>
    <view class="draft-brief">
      <text wx:if="{{item.title}}">标题：{{item.title}}</text>
      <text wx:if="{{item.content}}">内容摘要：{{item.content.slice(0, 20)}}...</text>
      <image wx:if="{{item.imageUrl}}" class="draft-thumb" src="{{item.imageUrl}}" mode="aspectFit"></image>
    </view>
  </view>

  <!-- 详情弹窗 -->
  <view class="modal-mask" wx:if="{{selectedDraft}}" catchtap="closeDetail">
    <view class="modal-content" catchtap="noop">
      <view class="modal-title">草案详情</view>
      <view class="modal-body">
        <view class="detail-row"><text>类型：</text>{{selectedDraft.type === 'activity' ? '活动' : selectedDraft.type === 'news' ? '新闻' : '表情包'}}</view>
        <view class="detail-row" wx:if="{{selectedDraft.title}}"><text>标题：</text>{{selectedDraft.title}}</view>
        <view class="detail-row" wx:if="{{selectedDraft.content}}"><text>内容：</text>{{selectedDraft.content}}</view>
        <block wx:if="{{selectedDraft.type === 'activity' && selectedDraft.formData}}">
          <view class="detail-row"><text>地点：</text>{{selectedDraft.formData.location}}</view>
          <view class="detail-row"><text>开始时间：</text>{{selectedDraft.formData.startTime}}</view>
          <view class="detail-row"><text>结束时间：</text>{{selectedDraft.formData.endTime}}</view>
          <view class="detail-row"><text>报名截止：</text>{{selectedDraft.formData.signupDeadline}}</view>
          <view class="detail-row"><text>人数上限：</text>{{selectedDraft.formData.maxParticipants}}</view>
          <view class="detail-row"><text>活动类型：</text>{{selectedDraft.formData.type}}</view>
          <view class="detail-row"><text>活动介绍：</text>{{selectedDraft.formData.description}}</view>
        </block>
        <image wx:if="{{selectedDraft.imageUrl}}" class="detail-image" src="{{selectedDraft.imageUrl}}" mode="aspectFit"></image>
      </view>
      <view class="modal-actions">
        <button type="primary" size="mini" bindtap="approveDraft">批准</button>
        <button type="warn" size="mini" bindtap="rejectDraft">拒绝</button>
        <button size="mini" bindtap="closeDetail">关闭</button>
      </view>
    </view>
  </view>
</view>