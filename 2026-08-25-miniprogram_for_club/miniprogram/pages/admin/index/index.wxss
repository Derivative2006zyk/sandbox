.container {
  position: relative;
  min-height: 100vh;
  padding: 220rpx 20rpx 20rpx;
  background: transparent;
  box-sizing: border-box;
}

.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.custom-back {
  position: fixed;
  top: 140rpx;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border-radius: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  font-size: 26rpx;
  color: #17498C;
}

.back-icon {
  font-size: 36rpx;
  line-height: 1;
}

.admin-title {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  font-weight: bold;
  color: #17498C;
  margin-bottom: 30rpx;
  text-align: center;
}

.menu-item {
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 25rpx 30rpx;
  font-size: 30rpx;
  color: #333;
}