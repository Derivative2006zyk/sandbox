.container {
  position: relative;
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  background: transparent;
}

/* 全局背景图 */
.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.admin-title {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  font-weight: bold;
  color: #17498C;
  margin-bottom: 30rpx;
}

.menu-item {
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
  padding: 25rpx 30rpx;
  font-size: 30rpx;
  color: #333;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}