<view class="splash-container" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <!-- 背景图片（最底层） -->
  <image class="bg-image" src="{{bgUrl}}" mode="aspectFill"></image>

  <!-- 社团 Logo（左上角） -->
  <image class="logo" src="{{logoUrl}}" mode="aspectFit"></image>

  <!-- 加载占位图覆盖层 -->
  <view class="loading-overlay" wx:if="{{loading}}">
    <view class="loading-card">
      <image class="loading-image" src="/images/hello.jpg" mode="aspectFit"></image>
      <text class="loading-title">请稍等</text>
      <text class="loading-emoticon">(＾▽＾)</text>
      <text class="loading-note">出于小程序性能限制，部分页面加载可能较慢，能力有限，恳请谅解</text>
      <progress percent="{{loadProgress}}" stroke-width="4" activeColor="#2F8DFF" backgroundColor="#e0e0e0" border-radius="8" />
      <text class="loading-text">{{loadProgress}}%</text>
      <button wx:if="{{loadError}}" class="retry-btn" bindtap="retryLoad">重新加载</button>
    </view>
  </view>

  <!-- 主视觉角色动画区（Canvas） -->
  <view class="hero" wx:if="{{!loading}}">
    <canvas 
      type="2d" 
      id="welcomeCanvas" 
      class="character-canvas"
    ></canvas>
  </view>

  <!-- 文案区 -->
  <view class="typography">
    <view class="title-group">
      <text class="main-title">欢迎来到 樱花日语社</text>
      <text class="sub-title">WELCOME TO Sakura Japanese Club</text>
    </view>
    <view class="cta-area">
      <button class="btn primary" bindtap="enterApp">
        <text>进入社团</text>
        <text class="plus">+</text>
      </button>
      <button class="btn secondary" bindtap="goToAbout">
        <text>了解更多</text>
      </button>
    </view>
  </view>

  <!-- 合规提示 -->
  <view class="compliance">
    <text>为了维护良好的社团环境，本平台暂不支持校外用户使用</text>
  </view>

  <!-- SCROLL 滚动提示 -->
  <view class="scroll-hint">
    <text class="scroll-text">上滑进入</text>
    <view class="triangle-down"></view>
  </view>

  <!-- 底部版权 -->
  <view class="footer">
    <text>© 2026 樱花日语社</text>
  </view>

  <!-- 右下角梯形导航盒子 -->
  <view class="trapezoid-nav">
    <view class="nav-logo">
      <text class="logo-main">樱花日语社</text>
      <text class="logo-sub">Sakura Japanese Club</text>
    </view>
  </view>
</view>