page {
  background-color: #FFFFFF;
}

/* 页面整体容器 */
.splash-container {
  position: relative;
  width: 100%;
  height: 100vh;
  background-color: #FFFFFF;
  overflow: hidden;
  font-family: 'HarmonyOS Sans', 'PingFang SC', sans-serif;
}

/* 背景图片（最底层，完全不透明） */
.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 1;
}

/* 顶部安全区占位 */
.splash-container::before {
  content: '';
  display: block;
  height: 44rpx;
}

/* 主视觉角色区（Canvas 容器） */
.hero {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  margin: 0 auto;
  width: 100%;
  display: flex;
  justify-content: center;
  z-index: 2;
}

/* Canvas 角色画布（尺寸不变） */
.character-canvas {
  width: 640rpx;
  height: 1150rpx;
  z-index: 1;
}

/* 文案区 */
.typography {
  position: relative;
  margin-top: 1100rpx;
  margin-right: 40rpx;
  margin-left: auto;
  z-index: 20;
  padding: 0 32rpx;
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.title-group {
  display: block;
  margin-left: 0;
}

.main-title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 72rpx;
  color: #17498C;
}

.sub-title {
  display: block;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #7BA2C4;
  letter-spacing: 2rpx;
  margin-top: 24rpx;
}

/* 操作按钮区 */
.cta-area {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 400rpx;
  height: 36rpx;
  margin-top: 20rpx;
  z-index: 20;
}

/* 按钮通用样式 */
.btn {
  flex: 1;
  height: 36rpx;
  border-radius: 8rpx;
  font-size: 16rpx;
  font-weight: bold;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  box-sizing: border-box;
  margin: 0 6rpx;
}

.btn:first-child { margin-left: 0; }
.btn:last-child { margin-right: 0; }
.btn.primary { background-color: #2F8DFF; }
.btn.primary .plus { margin-left: 4rpx; font-size: 16rpx; }
.btn.secondary { background-color: #000000; }

/* 合规提示 */
.compliance {
  position: relative;
  margin-top: 30rpx;
  margin-right: 70rpx;
  margin-left: auto;
  text-align: right;
  font-size: 20rpx;
  line-height: 32rpx;
  color: #999999;
  z-index: 20;
  width: 400rpx;
}

/* SCROLL 滚动提示 */
.scroll-hint {
  position: absolute;
  bottom: 80rpx;
  left: 0;
  width: 100%;
  text-align: center;
  color: #17498C;
  font-size: 24rpx;
  font-weight: bold;
  z-index: 20;
}

/* 底部版权 */
.footer {
  position: absolute;
  bottom: 20rpx;
  left: 0;
  width: 100%;
  text-align: center;
  font-size: 16rpx;
  color: #666666;
  z-index: 20;
}

/* 右下角梯形导航盒子：降低不透明度，减少对背景的遮挡 */
.trapezoid-nav {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 844rpx;
  height: 844rpx;
  background: rgba(255, 255, 255, 0.45);   /* 由0.65降低到0.45 */
  clip-path: polygon(0% 64%, 100% 42%, 100% 100%, 0% 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 15;
  padding: 80rpx;
}

.nav-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 0;
}

.logo-main {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
  line-height: 1;
}

.logo-sub {
  font-size: 14rpx;
  color: #A0D8EF;
  letter-spacing: 1rpx;
  margin-top: 4rpx;
}

/* 加载占位图覆盖层 */
.loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.95);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.loading-title { font-size: 36rpx; font-weight: bold; color: #17498C; }
.loading-text { font-size: 28rpx; color: #666; }
.retry-btn { margin-top: 20rpx; width: 200rpx; font-size: 28rpx; }