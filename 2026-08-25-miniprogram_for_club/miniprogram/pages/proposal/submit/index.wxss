.container {
  position: relative;
  min-height: 100vh;
  padding: 120rpx 20rpx 20rpx;
  background: transparent;
  box-sizing: border-box;
}

.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.custom-back {
  position: fixed;
  top: 20rpx;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border-radius: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  font-size: 26rpx;
  color: #17498C;
}

.back-icon {
  font-size: 36rpx;
  line-height: 1;
}

.glass-card {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 30rpx;
}

.draft-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #17498C;
  margin-bottom: 30rpx;
  text-align: center;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-item text {
  display: block;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  color: #333;
}

.form-item input,
.form-item textarea {
  width: 100%;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 15rpx;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.5);
  box-sizing: border-box;
}

.form-item textarea {
  min-height: 150rpx;
}

.radio-group label {
  margin-right: 20rpx;
}

/* 上传区域 */
.upload-area {
  width: 200rpx;
  height: 200rpx;
  border: 1rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.5);
}

.cover-preview {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
}

.upload-icon {
  font-size: 48rpx;
}

.upload-text {
  font-size: 24rpx;
}

.submit-btn {
  margin-top: 30rpx;
  width: 100%;
  background: #2F8DFF;
  color: #fff;
  border-radius: 8rpx;
  font-size: 30rpx;
}

/* 我的提交历史 */
.history-section {
  margin-top: 20rpx;
}

.history-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #17498C;
  margin-bottom: 20rpx;
}

.empty {
  text-align: center;
  color: #999;
  padding: 30rpx 0;
}

.history-item {
  background: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.history-type {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.history-status {
  font-size: 24rpx;
  color: #666;
}

.history-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.history-thumb {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  margin-top: 8rpx;
}

.history-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.history-time {
  font-size: 24rpx;
  color: #999;
}

.status-rect {
  width: 30rpx;
  height: 30rpx;
  border-radius: 6rpx;
}

.edit-history-btn {
  width: 100%;
  background: #2F8DFF;
  color: #fff;
  border-radius: 8rpx;
}