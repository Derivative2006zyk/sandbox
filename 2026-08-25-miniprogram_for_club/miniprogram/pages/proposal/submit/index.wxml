<view class="container">
  <!-- 全局背景图 -->
  <image class="page-bg" src="{{bgUrl}}" mode="aspectFill"></image>

  <!-- 自定义返回按钮 -->
  <view class="custom-back" bindtap="goBack">
    <text class="back-icon">‹</text>
    <text class="back-text">返回</text>
  </view>

  <!-- 提交草案表单 -->
  <view class="draft-card glass-card">
    <view class="draft-title">提交草案</view>

    <!-- 类型选择 -->
    <view class="form-item">
      <text>类型</text>
      <radio-group bindchange="onTypeChange">
        <label><radio value="activity" checked="{{type === 'activity'}}" />活动</label>
        <label><radio value="news" checked="{{type === 'news'}}" />新闻</label>
        <label><radio value="emoji" checked="{{type === 'emoji'}}" />表情包</label>
      </radio-group>
    </view>

    <!-- 活动和新闻共有：标题 -->
    <view class="form-item" wx:if="{{type !== 'emoji'}}">
      <text>标题</text>
      <input value="{{title}}" bindinput="onTitleInput" placeholder="请输入标题" />
    </view>

    <!-- 新闻：内容 -->
    <view class="form-item" wx:if="{{type === 'news'}}">
      <text>内容</text>
      <textarea value="{{content}}" bindinput="onContentInput" placeholder="请输入新闻内容" auto-height></textarea>
    </view>

    <!-- 活动：其他字段 -->
    <block wx:if="{{type === 'activity'}}">
      <view class="form-item">
        <text>地点</text>
        <input value="{{location}}" data-field="location" bindinput="onFormDataInput" placeholder="活动地点" />
      </view>
      <view class="form-item">
        <text>开始时间</text>
        <input value="{{startTime}}" data-field="startTime" bindinput="onFormDataInput" placeholder="如：2026-09-01 19:00" />
      </view>
      <view class="form-item">
        <text>结束时间</text>
        <input value="{{endTime}}" data-field="endTime" bindinput="onFormDataInput" placeholder="如：2026-09-01 21:00" />
      </view>
      <view class="form-item">
        <text>报名截止</text>
        <input value="{{signupDeadline}}" data-field="signupDeadline" bindinput="onFormDataInput" placeholder="如：2026-08-31 23:59" />
      </view>
      <view class="form-item">
        <text>人数上限</text>
        <input type="number" value="{{maxParticipants}}" data-field="maxParticipants" bindinput="onFormDataInput" placeholder="最大报名人数" />
      </view>
      <view class="form-item">
        <text>活动类型</text>
        <input value="{{activityType}}" data-field="activityType" bindinput="onFormDataInput" placeholder="如：讲座、聚会" />
      </view>
      <view class="form-item">
        <text>活动介绍</text>
        <textarea value="{{description}}" data-field="description" bindinput="onFormDataInput" placeholder="活动详细介绍" auto-height></textarea>
      </view>
    </block>

    <!-- 表情：上传图片 -->
    <view class="form-item" wx:if="{{type === 'emoji'}}">
      <text>表情图片</text>
      <view class="upload-area" bindtap="uploadEmojiImage">
        <image wx:if="{{emojiPreview}}" class="cover-preview" src="{{emojiPreview}}" mode="aspectFit"></image>
        <view wx:else class="upload-placeholder">
          <text class="upload-icon">＋</text>
          <text class="upload-text">点击上传图片</text>
        </view>
      </view>
    </view>

    <button class="submit-btn" bindtap="submitDraft" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交草案'}}
    </button>
  </view>

  <!-- 我的提交历史记录 -->
  <view class="history-section glass-card">
    <view class="history-title">我的提交</view>
    <view wx:if="{{myDrafts.length === 0 && !loadingHistory}}" class="empty">暂无提交记录</view>

    <view class="history-item" wx:for="{{myDrafts}}" wx:key="_id">
      <view class="history-header">
        <text class="history-type">{{item.type === 'activity' ? '活动' : item.type === 'news' ? '新闻' : '表情包'}}</text>
        <text class="history-status">{{item.status === 'approved' ? '已通过' : item.status === 'rejected' ? '未通过' : '待审核'}}</text>
      </view>
      <view class="history-detail">
        <text wx:if="{{item.title}}">标题：{{item.title}}</text>
        <text wx:if="{{item.content}}">内容摘要：{{item.content.slice(0, 20)}}...</text>
        <image wx:if="{{item.imageUrl}}" class="history-thumb" src="{{item.imageUrl}}" mode="aspectFit" lazy-load></image>
      </view>
      <view class="history-meta">
        <text class="history-time">提交时间：{{item.createTime}}</text>
        <!-- 状态占位矩形 -->
        <view class="status-rect" style="background: {{item.status === 'approved' ? '#52c41a' : item.status === 'rejected' ? '#ff4d4f' : '#bfbfbf'}};"></view>
      </view>
      <button wx:if="{{item.status === 'rejected'}}" class="edit-history-btn" size="mini" bindtap="editDraft" data-id="{{item._id}}">修改</button>
    </view>
  </view>

  <!-- 隐藏压缩画布 -->
  <canvas canvas-id="compressCanvas" style="width: 300px; height: 300px; position: fixed; left: 9999px; top: 9999px;"></canvas>
</view>