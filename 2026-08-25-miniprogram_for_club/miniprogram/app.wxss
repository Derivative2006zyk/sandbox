/* ========== 全局样式（亮色青春 + 暗色档案） ========== */
page {
  /* 亮色主题变量 */
  --bg-start: #F7FBFF;
  --bg-end: #E8F4FF;
  --primary: #00A3FF;
  --accent: #FF5D9E;
  --text-main: #1A1E24;
  --text-sub: #666666;
  --card-bg: rgba(255, 255, 255, 0.7);
  --border-line: rgba(0, 0, 0, 0.05);
  --orange: #FF6100;
  --cyan: #00FFF2;
  --font-title: 'Oswald', 'Roboto Mono', 'PingFang SC', sans-serif;
  --font-body: 'HarmonyOS Sans', 'PingFang SC', sans-serif;

  /* 背景色改为纯色或渐变，不使用背景图 */
  background: #F7FBFF;
  font-family: var(--font-body);
  color: var(--text-main);
}

/* 毛玻璃卡片、切角按钮等其他样式保持不变 */